# OAuth credentials — required for Gmail/Outlook sign-in.
# See README.md for setup instructions.

# Gmail: Create at https://console.cloud.google.com/
# Enable Gmail API, create OAuth 2.0 credentials (Desktop app type),
# add http://127.0.0.1:12141 as authorized redirect URI
MS_GMAIL_CLIENT_ID=
MS_GMAIL_CLIENT_SECRET=

# Outlook: Register at https://portal.azure.com/
# Add http://localhost:12141/desktop as redirect URI
MS_O365_CLIENT_ID=

# Optional: custom path to mailsync binary directory
# MAILSYNC_DIR=/path/to/mailsync

# Demo mode: populate UI with fake data for screenshots (no real emails)
# DEMO_MODE=true
